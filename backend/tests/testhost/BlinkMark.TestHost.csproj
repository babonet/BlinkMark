<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <RootNamespace>BlinkMark.TestHost</RootNamespace>
    <!--
      A support library, not a test project. Without this, `dotnet test` on the solution tries to
      run it as one and fails because it carries no test SDK.
    -->
    <IsTestProject>false</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" />
    <PackageReference Include="xunit" />
    <PackageReference Include="FluentAssertions" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\BlinkMark.Api\BlinkMark.Api.csproj" />
    <ProjectReference Include="..\..\src\BlinkMark.Preview\BlinkMark.Preview.csproj" />
  </ItemGroup>

</Project>
