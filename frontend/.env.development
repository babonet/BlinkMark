# Local development configuration for the frontend.
#
# Committed on purpose. Every value below is a localhost address or an obvious placeholder — there
# is no credential here, and there cannot be: the SPA is a public client and holds no secret by
# design (Principle VII). Committing this means `npm run dev` works from a clean clone.
#
# Pairs with the local host:
#   dotnet run --project backend/tools/BlinkMark.LocalHost
#
# Vite loads .env.development automatically for `npm run dev` and never for `vite build`.

VITE_API_ORIGIN=http://localhost:5080

# A different origin from the API and from this app, deliberately. `localhost` and `127.0.0.1` are
# distinct origins to a browser even though they are the same machine, so the preview is properly
# isolated locally without editing a hosts file (Principle IV).
VITE_PREVIEW_ORIGIN=http://127.0.0.1:5081

# Not used when VITE_LOCAL_DEV_AUTH is on, but config.ts requires them to be present. Obvious
# placeholders: a value copied from here into a real deployment should be recognisable as wrong.
VITE_ENTRA_TENANT_ID=00000000-0000-0000-0000-000000000000
VITE_ENTRA_CLIENT_ID=00000000-0000-0000-0000-000000000000
VITE_API_SCOPE=api://blinkmark-local/Files.ReadWrite api://blinkmark-local/Comments.ReadWrite

# Take the access token from the local host instead of Entra. The token is a genuine JWT and the
# API validates it with the production handler; only the issuer differs. This has no effect
# outside a Vite dev build — see services/localAuth.ts.
VITE_LOCAL_DEV_AUTH=true

# Who you are signed in as. Change it, reload, and you are someone else — which is how to see a
# file the way a colleague sees it, and to watch ownership actually being enforced.
VITE_LOCAL_DEV_USER=alice
