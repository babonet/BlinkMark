<Project>

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <!--
      The plan pins .NET 9. Only the .NET 10 runtime is present on some machines, so
      framework-dependent output rolls forward rather than failing to start. The compile-time
      target framework remains net9.0 so the plan's contract is what is actually enforced.
    -->
    <RollForward>LatestMajor</RollForward>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

</Project>
